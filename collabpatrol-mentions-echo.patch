+++ b/includes/Hooks/EchoHooks.php
@@ -0,0 +1,55 @@
+<?php
+
+namespace MediaWiki\Extension\CollabPatrol\Hooks;
+
+use MediaWiki\Extension\CollabPatrol\Notifications\MentionNotifier;
+use MediaWiki\Extension\CollabPatrol\Notifications\MentionPresentationModel;
+use MediaWiki\MediaWikiServices;
+
+/**
+ * Echo integration. These hooks are only called when the Echo extension is loaded.
+ */
+class EchoHooks {
+
+	public static function onBeforeCreateEchoEvent(
+		array &$notifications,
+		array &$notificationCategories,
+		array &$icons
+	): void {
+		$notificationCategories[MentionNotifier::EVENT_TYPE] = [
+			'priority' => 3,
+			'tooltip' => 'echo-pref-tooltip-collabpatrol-mention',
+		];
+
+		$notifications[MentionNotifier::EVENT_TYPE] = [
+			'category' => MentionNotifier::EVENT_TYPE,
+			'group' => 'interactive',
+			'section' => 'alert',
+			'presentation-model' => MentionPresentationModel::class,
+			'user-locators' => [ [ self::class . '::locateMentionedUsers' ] ],
+			'icon' => 'mention',
+		];
+	}
+
+	/**
+	 * Echo user locator: returns the users listed in the event's "mentioned-user-ids".
+	 *
+	 * @param \MediaWiki\Extension\Notifications\Model\Event $event
+	 * @return \MediaWiki\User\User[] Keyed by user ID
+	 */
+	public static function locateMentionedUsers( $event ): array {
+		$ids = $event->getExtraParam( 'mentioned-user-ids', [] );
+		if ( !is_array( $ids ) ) {
+			return [];
+		}
+		$userFactory = MediaWikiServices::getInstance()->getUserFactory();
+		$users = [];
+		foreach ( $ids as $id ) {
+			$id = (int)$id;
+			if ( $id > 0 ) {
+				$users[$id] = $userFactory->newFromId( $id );
+			}
+		}
+		return $users;
+	}
+}
diff --git a/includes/MentionParser.php b/includes/MentionParser.php
new file mode 100644
index 0000000..ad8e3db
--- /dev/null
+++ b/includes/MentionParser.php
@@ -0,0 +1,53 @@
+<?php
+
+namespace MediaWiki\Extension\CollabPatrol;
+
+/**
+ * Extracts @mentions from a chat message.
+ *
+ * Supported syntaxes:
+ *  - @Username            (underscores are read as spaces: @Jean_Dupont)
+ *  - @[User with spaces]
+ */
+class MentionParser {
+
+	public const MAX_MENTIONS = 5;
+
+	private const MAX_CANDIDATES = 10;
+
+	private const PATTERN = '/(?<![\p{L}\p{N}_@\/])@(?:\[([^\[\]\r\n]{1,85})\]|([\p{L}\p{N}_][\p{L}\p{N}_.\'\-]{0,84}))/u';
+
+	/**
+	 * @param string $message
+	 * @return array[] List of [ 'raw' => string, 'name' => string ]
+	 */
+	public static function extract( string $message ): array {
+		if ( !preg_match_all( self::PATTERN, $message, $matches, PREG_SET_ORDER ) ) {
+			return [];
+		}
+
+		$found = [];
+		foreach ( $matches as $m ) {
+			if ( isset( $m[2] ) && $m[2] !== '' ) {
+				$name = rtrim( $m[2], ".'-" );
+				if ( $name === '' ) {
+					continue;
+				}
+				$raw = '@' . $name;
+			} else {
+				$name = $m[1] ?? '';
+				$raw = '@[' . $name . ']';
+			}
+			$name = trim( str_replace( '_', ' ', $name ) );
+			if ( $name === '' ) {
+				continue;
+			}
+			$found[$raw] = [ 'raw' => $raw, 'name' => $name ];
+			if ( count( $found ) >= self::MAX_CANDIDATES ) {
+				break;
+			}
+		}
+
+		return array_values( $found );
+	}
+}
diff --git a/includes/Notifications/MentionNotifier.php b/includes/Notifications/MentionNotifier.php
new file mode 100644
index 0000000..b886a34
--- /dev/null
+++ b/includes/Notifications/MentionNotifier.php
@@ -0,0 +1,54 @@
+<?php
+
+namespace MediaWiki\Extension\CollabPatrol\Notifications;
+
+use MediaWiki\Extension\Notifications\Model\Event;
+use MediaWiki\Logger\LoggerFactory;
+use MediaWiki\MediaWikiServices;
+use MediaWiki\Registration\ExtensionRegistry;
+
+class MentionNotifier {
+
+	public const EVENT_TYPE = 'collabpatrol-mention';
+
+	/**
+	 * Creates one Echo event notifying every recipient of a mention.
+	 *
+	 * @param int $pageId Page the patrolled revision belongs to
+	 * @param int $revId Patrolled revision
+	 * @param \MediaWiki\User\User $agent Author of the chat message
+	 * @param string $message Chat message
+	 * @param int[] $recipientIds User IDs to notify
+	 * @return bool Whether an event was created
+	 */
+	public static function notify( int $pageId, int $revId, $agent, string $message, array $recipientIds ): bool {
+		if ( !$recipientIds || !ExtensionRegistry::getInstance()->isLoaded( 'Echo' ) ) {
+			return false;
+		}
+
+		$title = MediaWikiServices::getInstance()->getTitleFactory()->newFromID( $pageId );
+		if ( !$title ) {
+			return false;
+		}
+
+		try {
+			Event::create( [
+				'type' => self::EVENT_TYPE,
+				'title' => $title,
+				'agent' => $agent,
+				'extra' => [
+					'cp-revid' => $revId,
+					'excerpt' => mb_strimwidth( $message, 0, 140, '…' ),
+					'mentioned-user-ids' => array_values( array_map( 'intval', $recipientIds ) ),
+				],
+			] );
+			return true;
+		} catch ( \Throwable $e ) {
+			LoggerFactory::getInstance( 'CollabPatrol' )->warning(
+				'Could not create Echo mention event: {message}',
+				[ 'message' => $e->getMessage() ]
+			);
+			return false;
+		}
+	}
+}
diff --git a/includes/Notifications/MentionPresentationModel.php b/includes/Notifications/MentionPresentationModel.php
new file mode 100644
index 0000000..9cbb82d
--- /dev/null
+++ b/includes/Notifications/MentionPresentationModel.php
@@ -0,0 +1,59 @@
+<?php
+
+namespace MediaWiki\Extension\CollabPatrol\Notifications;
+
+use MediaWiki\Extension\Notifications\Formatters\EchoEventPresentationModel;
+
+class MentionPresentationModel extends EchoEventPresentationModel {
+
+	/** @inheritDoc */
+	public function canRender() {
+		return (bool)$this->event->getTitle();
+	}
+
+	/** @inheritDoc */
+	public function getIconType() {
+		return 'mention';
+	}
+
+	/** @inheritDoc */
+	public function getHeaderMessage() {
+		$msg = $this->msg( 'notification-header-collabpatrol-mention' );
+		$msg->params(
+			$this->getAgentForOutput(),
+			$this->getTruncatedTitleText( $this->event->getTitle(), true ),
+			$this->getViewingUserForGender()
+		);
+		return $msg;
+	}
+
+	/** @inheritDoc */
+	public function getBodyMessage() {
+		$excerpt = $this->event->getExtraParam( 'excerpt' );
+		if ( !is_string( $excerpt ) || $excerpt === '' ) {
+			return false;
+		}
+		$msg = new \RawMessage( '$1' );
+		$msg->plaintextParams( $excerpt );
+		return $msg;
+	}
+
+	/** @inheritDoc */
+	public function getPrimaryLink() {
+		$title = $this->event->getTitle();
+		$revId = (int)$this->event->getExtraParam( 'cp-revid', 0 );
+		if ( !$title || !$revId ) {
+			return false;
+		}
+		return [
+			'url' => $title->getFullURL( [ 'diff' => $revId ] ) . '#cp-chat',
+			'label' => $this->msg( 'collabpatrol-echo-link-discussion' )->text(),
+		];
+	}
+
+	/** @inheritDoc */
+	public function getSecondaryLinks() {
+		$agentLink = $this->getAgentLink();
+		return $agentLink ? [ $agentLink ] : [];
+	}
+}
